# Supabase (free tier) - supabase.com pe project banao, phir ye values dalo
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare R2 (optional, baad me) - S3-compatible
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=wsta-posts
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# App
NEXT_PUBLIC_APP_NAME=WSTA
